{
  "name": "nogatudrop-backend",
  "version": "1.0.0",
  "description": "Nogatu NCDMS Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --env-file=.env.dev src/server.js",
    "start": "node --env-file=.env.prod src/server.js",
    "seed": "node --env-file=.env.dev src/seed.js",
    "seed:prod": "node --env-file=.env.prod src/seed.js",
    "db:audit": "node --env-file=.env.dev scripts/exportDatabaseAudit.js",
    "migrate:finalize": "node --env-file=.env.dev scripts/runSqlFile.js sql/finalize_schema_2026_04_14.sql",
    "migrate:finalize:prod": "node --env-file=.env.prod scripts/runSqlFile.js sql/finalize_schema_2026_04_14.sql",
    "migrate:repair": "node --env-file=.env.dev scripts/runSqlFile.js sql/repair_core_operational_schema_2026_05_07.sql",
    "migrate:repair:prod": "node --env-file=.env.prod scripts/runSqlFile.js sql/repair_core_operational_schema_2026_05_07.sql",
    "migrate:city-mobile-logins": "node --env-file=.env.dev scripts/runSqlFile.js sql/add_city_and_mobile_logins_2026_05_07.sql",
    "migrate:city-mobile-logins:prod": "node --env-file=.env.prod scripts/runSqlFile.js sql/add_city_and_mobile_logins_2026_05_07.sql",
    "migrate:affiliations": "node --env-file=.env.dev scripts/runSqlFile.js sql/repair_role_affiliations_2026_05_17.sql",
    "migrate:affiliations:prod": "node --env-file=.env.prod scripts/runSqlFile.js sql/repair_role_affiliations_2026_05_17.sql",
    "migrate:stock-movements": "node --env-file=.env.dev scripts/runSqlFile.js sql/repair_stock_movement_types_2026_05_17.sql",
    "migrate:stock-movements:prod": "node --env-file=.env.prod scripts/runSqlFile.js sql/repair_stock_movement_types_2026_05_17.sql",
    "migrate:ops-personnel": "node --env-file=.env.dev scripts/runSqlFile.js sql/repair_operational_personnel_chain_2026_05_18.sql",
    "migrate:ops-personnel:prod": "node --env-file=.env.prod scripts/runSqlFile.js sql/repair_operational_personnel_chain_2026_05_18.sql",
    "migrate:catalog-sync": "node --env-file=.env.dev scripts/syncNogatuMlmCatalog.js",
    "seed:hierarchy": "node --env-file=.env.dev scripts/seedAffiliationHierarchy.js",
    "seed:hierarchy:prod": "node --env-file=.env.prod scripts/seedAffiliationHierarchy.js",
    "smoke:verify": "node --env-file=.env.dev scripts/smokeApiVerify.js",
    "smoke:deep": "node --env-file=.env.dev scripts/smokeApiHealth.js",
    "smoke:hierarchy": "node --env-file=.env.dev scripts/smokeAffiliationHierarchy.js",
    "smoke:roles": "node --env-file=.env.dev scripts/smokeRoleOperations.js",
    "smoke:mutations": "node --env-file=.env.dev scripts/smokeOperationalMutations.js",
    "smoke:catalog": "node --env-file=.env.dev scripts/smokeCatalogSync.js",
    "smoke:health": "npm run smoke:verify",
    "readiness:post-deploy": "node --env-file=.env.dev scripts/postDeployReadiness.js",
    "readiness:post-deploy:prod": "node --env-file=.env.prod scripts/postDeployReadiness.js",
    "readiness:baseline": "node --env-file=.env.dev scripts/exportOperationalBaseline.js",
    "readiness:restore-verify": "node --env-file=.env.dev scripts/verifyRestoreDrill.js",
    "readiness:load": "node --env-file=.env.dev scripts/loadPublicSurface.js",
    "post:migration": "node --env-file=.env.dev scripts/postMigration.js",
    "post:migration:deep": "set RUN_DEEP_SMOKE=true&& node --env-file=.env.dev scripts/postMigration.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.3",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.9.0",
    "node-cron": "^3.0.3",
    "rate-limit-redis": "^4.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  }
}
